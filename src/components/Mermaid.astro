---
/**
 * A Mermaid diagram in a captioned figure.
 *
 * The graph source is rendered as text inside the figure. Mermaid replaces it
 * with an SVG on load; if the script fails or JavaScript is off, the reader
 * still sees the (readable) diagram definition rather than an empty box.
 *
 * Mermaid is a dependency of this project rather than a CDN script, so the
 * version is pinned and the site has no third-party runtime requests.
 */
interface Props {
  /** Mermaid graph definition. */
  code: string;
  /** Caption shown under the diagram. */
  caption?: string;
}

const { code, caption } = Astro.props;
---

<figure class="figure">
  <pre class="mermaid">{code.trim()}</pre>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { EVT_DIAGRAMS, EVT_THEME } from '../lib/keys';

  const nodes = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'));

  // Mermaid is a large dependency, so it is imported dynamically: pages with no
  // diagram never download it, and pages that do have one render their text
  // first and upgrade to SVG afterwards.
  if (nodes.length) {
    const { default: mermaid } = await import('mermaid');

    // Keep the original source so the diagram can be re-rendered when the
    // theme flips (Mermaid bakes colours into the generated SVG).
    nodes.forEach((n) => {
      if (!n.dataset.src) n.dataset.src = n.textContent ?? '';
    });

    const read = (name: string, fallback: string) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    };

    async function render() {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif',
        flowchart: { curve: 'basis', useMaxWidth: true, htmlLabels: true },
        sequence: { useMaxWidth: true },
        // Themed from the same Primer tokens as the page, so diagrams follow the
        // switcher: nodes on the tertiary surface with an accent-blue border,
        // clusters on the canvas, inside a figure on the secondary surface.
        themeVariables: {
          darkMode: dark,
          background: read('--surface', '#f6f8fa'),
          primaryColor: read('--surface-2', '#eff2f5'),
          primaryTextColor: read('--text', '#1f2328'),
          primaryBorderColor: read('--accent-blue', '#0969da'),
          secondaryColor: read('--surface-3', '#e6eaef'),
          tertiaryColor: read('--bg', '#ffffff'),
          lineColor: read('--text-soft', '#59636e'),
          textColor: read('--text-soft', '#59636e'),
          mainBkg: read('--surface-2', '#eff2f5'),
          nodeBorder: read('--accent-blue', '#0969da'),
          clusterBkg: read('--bg', '#ffffff'),
          clusterBorder: read('--border', '#d0d7de'),
          titleColor: read('--text', '#1f2328'),
          edgeLabelBackground: read('--surface', '#f6f8fa'),
          // Sequence diagrams.
          actorBkg: read('--surface-2', '#eff2f5'),
          actorBorder: read('--accent-blue', '#0969da'),
          actorTextColor: read('--text', '#1f2328'),
          signalColor: read('--text-soft', '#59636e'),
          signalTextColor: read('--text', '#1f2328'),
          noteBkgColor: read('--surface-3', '#e6eaef'),
          noteBorderColor: read('--border', '#d0d7de'),
          noteTextColor: read('--text', '#1f2328'),
        },
      });

      // Reset every node to its source before re-running.
      nodes.forEach((n) => {
        n.removeAttribute('data-processed');
        n.textContent = n.dataset.src ?? '';
      });

      try {
        await mermaid.run({ nodes });
      } catch (err) {
        console.warn('Mermaid render failed', err);
      }

      // Wide diagrams would otherwise shrink to fit a phone until the labels are
      // unreadable. Give each a floor of 560px (or its natural width, if smaller)
      // so a narrow figure scrolls sideways instead of scaling the text away.
      nodes.forEach((n) => {
        const svg = n.querySelector('svg');
        const natural = svg?.viewBox?.baseVal?.width;
        if (svg && natural) svg.style.minWidth = `${Math.min(natural, 560)}px`;
      });

      // Rendering changes the page height by tens of thousands of pixels, which
      // invalidates any anchor scroll the browser already performed.
      window.dispatchEvent(new CustomEvent(EVT_DIAGRAMS));
    }

    render();
    window.addEventListener(EVT_THEME, () => {
      render();
    });
  }
</script>
