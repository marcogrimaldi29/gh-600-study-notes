---
import BaseLayout from './BaseLayout.astro';
import OnThisPage from '../components/OnThisPage.astro';
import Pager from '../components/Pager.astro';
import Octicon from '../components/Octicon.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE, pageBySlug } from '../data/site';
import { absolute, href } from '../lib/urls';

interface Props {
  slug: string;
  /** Browser/tab title. Defaults to "<label> — GH-600 Study Notes". */
  title?: string;
  description: string;
  /** Page heading. Defaults to the label in the page registry. */
  heading?: string;
  /** Standfirst under the heading. */
  intro: string;
  themeColor?: string;
}

const { slug, title, description, heading, intro, themeColor } = Astro.props;

const page = pageBySlug(slug);
if (!page) throw new Error(`NoteLayout: "${slug}" is not registered in src/data/site.ts`);

const docTitle = title ?? `${page.label} — ${SITE.name}`;

const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${absolute(SITE.origin, slug)}#article`,
    headline: heading ?? page.label,
    description,
    url: absolute(SITE.origin, slug),
    inLanguage: 'en',
    isPartOf: { '@id': `${absolute(SITE.origin, '')}#website` },
    author: { '@id': `${SITE.origin}/#person` },
    about: `Exam ${SITE.exam}: ${SITE.examTitle}`,
  },
];
---

<BaseLayout
  title={docTitle}
  description={description}
  slug={slug}
  themeColor={themeColor}
  ogType="article"
  schema={schema}
>
  <div class="layout" data-sidebar="expanded" data-drawer="closed">
    <Sidebar current={slug} />

    {/* .page is an inner grid so the outline can sit beside the prose on wide
        screens and drop between the title and the body on narrow ones, without
        the element existing twice in the DOM. */}
    <main class="page" id="main" style={`--accent:${page.accent}`}>
      <header class="page-head">
        {/* A repository-path style breadcrumb, as on the sister sites. */}
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={href('')}>Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <span aria-current="page">{page.navLabel}</span>
        </nav>
        <h1>{heading ?? page.label}</h1>
        <p class="lead">{intro}</p>
        <div class="page-labels">
          {
            page.skill ? (
              <>
                <span class="label l-accent">
                  <Octicon name={page.icon} size={12} />
                  Skill {page.skill}
                </span>
                <span class="label l-neutral">{page.weight} of the exam</span>
              </>
            ) : (
              <span class="label l-accent">
                <Octicon name={page.icon} size={12} />
                {page.badge}
              </span>
            )
          }
          {/* Stated on every page so a reader can tell at a glance whether the
              notes have gone stale against the official study guide. */}
          <span class="label l-neutral">
            <Octicon name="calendar" size={12} />
            Skills measured: study guide revision of {SITE.skillsMeasured}
          </span>
        </div>
      </header>

      <OnThisPage />

      <div class="content">
        <slot />
      </div>

      <Pager current={slug} />
    </main>
  </div>
</BaseLayout>
