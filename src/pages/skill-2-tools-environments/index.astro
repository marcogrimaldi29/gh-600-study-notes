import CodeBlock from '../../components/CodeBlock.astro';
import Mermaid from '../../components/Mermaid.astro';
import { href } from '../../lib/urls';

const mcpModel = `
flowchart LR
  subgraph GOV["Organization and enterprise policy"]
    direction LR
    REG["MCP registry<br/>catalogue of approved servers"] --> CLIENT["MCP client<br/>IDE · Copilot CLI"]
    ALLOW["Allowlist policy<br/>MCP servers in Copilot · managed settings"] --> CLIENT
  end
  CLIENT --> SERVER["MCP server<br/>local stdio or remote HTTP"]
  SERVER --> SYS["Underlying system<br/>GitHub · Sentry · Azure · Jira"]
`;

const mcpOrder = `
flowchart LR
  OOB["1 · Out-of-the-box servers<br/>GitHub MCP · Playwright MCP"] --> AGENT["2 · Custom agent profile<br/>mcp-servers property"]
  AGENT --> REPO["3 · Repository settings<br/>Settings → Copilot → MCP servers"]
  REPO --> EFFECTIVE["Effective configuration<br/>later levels override earlier ones"]
`;

const ciInvoke = `
flowchart TB
  TRIG["Trigger<br/>schedule · workflow_dispatch · pull_request"] --> JOB
  subgraph JOB["Workflow job — the execution boundary"]
    direction TB
    CO["Checkout"] --> INST["Install Copilot CLI<br/>npm install -g @github/copilot"]
    INST --> RUN["copilot -p prompt<br/>--allow-tool · --no-ask-user · -s"]
    RUN --> OUT["Publish result<br/>step summary · artifact · safe output"]
  end
`;

const recovery = `
flowchart TB
  FAIL["Required check fails"] --> RETRY{"Attempts < 2?"}
  RETRY -->|"yes"| FIX["Agent revises the branch<br/>and re-runs checks"]
  FIX --> FAIL2{"Green?"}
  FAIL2 -->|"yes"| REVIEW["Human review and merge"]
  FAIL2 -->|"no"| RETRY
  RETRY -->|"no"| ESC["Escalate<br/>what failed · what was tried · evidence · next step"]
  ESC --> HUMAN["Human decides<br/>fix · close PR · revert"]
`;

const agentTools = `---
name: security-reviewer
description: Reviews changes for vulnerabilities and reports findings. Read-only; never edits code.
tools: ["read", "search", "github/*"]
---

Review the changes on this branch for injection, secrets, unsafe deserialization and
missing authorization checks. Report each finding with file, line and a suggested fix.
Do not modify files.`;

const repoMcp = `{
  "mcpServers": {
    "sentry": {
      "type": "local",
      "command": "npx",
