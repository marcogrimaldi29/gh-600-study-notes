  }
}`;

const agentMcp = `---
name: incident-triage
description: Correlates production errors with recent commits
tools: ["read", "search", "sentry/get_issue_details"]
mcp-servers:
  sentry:
    type: local
    command: npx
    args: ["@sentry/mcp-server@latest"]
    tools: ["*"]
    env:
      SENTRY_ACCESS_TOKEN: \${{ secrets.COPILOT_MCP_SENTRY_TOKEN }}
---

Find the Sentry issue referenced in the task and identify the commit most likely to have caused it.`;

const githubMcpWide = `{
