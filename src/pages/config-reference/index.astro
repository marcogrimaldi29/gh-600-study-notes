---
import NoteLayout from '../../layouts/NoteLayout.astro';
import Callout from '../../components/Callout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Mermaid from '../../components/Mermaid.astro';
import { href } from '../../lib/urls';

const fileMap = `
flowchart TB
  subgraph REPO["Repository — versioned in Git"]
    direction TB
    subgraph DOTGH[".github/ — protect it with CODEOWNERS"]
      direction LR
      INSTR["copilot-instructions.md<br/>instructions/*.instructions.md"]
      AGENTS["agents/*.agent.md"]
      SKILLS["skills/NAME/SKILL.md"]
      HOOKS["hooks/*.json"]
      WF["workflows/copilot-setup-steps.yml<br/>workflows/*.md + *.lock.yml"]
    end
    ROOTF["AGENTS.md · CLAUDE.md · GEMINI.md · CODEOWNERS"]
  end
  subgraph SETTINGS["Repository settings — not in Git"]
    direction LR
    MCPS["Copilot → MCP servers<br/>JSON"]
    NET["Copilot → Internet access<br/>firewall"]
    SEC["Secrets and variables → Agents"]
  end
`;

const agentProfile = `---
name: test-specialist                  # optional; defaults to the file name
description: Improves test coverage without changing production code   # REQUIRED
target: github-copilot                 # vscode | github-copilot; omit for both
tools: ["read", "search", "edit", "execute", "github/*"]   # omit or ["*"] = all; [] = none
model: gpt-5.4                         # optional; inherits the default if unset
disable-model-invocation: false        # true = never auto-selected (and not callable as a subagent)
user-invocable: true                   # false = hidden from manual selection, programmatic only
mcp-servers:                           # this agent only; ignored by IDE custom agents
  coverage:
    type: local
    command: npx
    args: ["coverage-mcp@latest"]
    tools: ["get_report"]
metadata:
  owner: qa-platform
---

You are a testing specialist. Analyse coverage gaps and add unit and integration tests.
Only change files under tests/. Never delete or skip an existing test.`;

const repoInstructions = `# .github/copilot-instructions.md — repository-wide, applied to every request
This is a Go service with a Ruby client.

## Build and test
- Build: make build
- Test:  make test      (run before every commit)
- Full CI check: make ci

## Conventions
- Run make fmt before committing.
- Changes under proto/ require make proto.`;

const pathSpecific = `---
applyTo: "**/*.ts,**/*.tsx"
excludeAgent: "code-review"      # or "cloud-agent"; omit to apply to both
---

Use strict TypeScript. Prefer named exports. Every component needs a test.`;

const skillMd = `---
name: github-actions-failure-debugging          # lowercase, hyphenated; matches the folder
description: Debug failing GitHub Actions workflows. Use when asked to fix a failing CI run.
allowed-tools: shell                            # optional pre-approval — trusted skills only
---

1. Use list_workflow_runs to find the failing run for the PR.
2. Use summarize_job_log_failures to understand what failed.
3. Reproduce the failure locally, fix it, and confirm before committing.`;

const setupSteps = `jobs:
  copilot-setup-steps:        # exact name required; file must be on the default branch
    runs-on: ubuntu-latest    # larger, self-hosted (ARC) or Windows labels allowed
    timeout-minutes: 30       # <= 59
    permissions:
      contents: read
    services:                 # e.g. a database for integration tests
      postgres:
        image: postgres:17
        env:
          POSTGRES_PASSWORD: postgres
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: "24"
          cache: "npm"
      - run: npm ci`;

const mcpJson = `{
