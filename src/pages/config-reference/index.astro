const denyOutput = `{"permissionDecision": "deny", "permissionDecisionReason": "Force pushes are not allowed"}`;

const agenticWorkflow = `---
on:
  schedule: daily                 # any GitHub Actions trigger
permissions:
  contents: read                  # read-only unless you grant more
  issues: read
  pull-requests: read
  copilot-requests: write         # bill Copilot usage to the organization via GITHUB_TOKEN
engine: copilot                   # default; claude, codex and gemini also supported
network: defaults                 # firewalled egress
tools:
  github:
    toolsets: [default]
safe-outputs:
  create-issue:                   # the ONLY write this workflow may perform
    title-prefix: "[repo-status] "
    labels: [report]
max-ai-credits: 300               # per-run cap (default 1,000 AIC)
---

# Daily repository status

Summarize the last 24 hours of issues, pull requests and commits.
Highlight blockers and recommend next steps. Keep it short and link everything.`;

const ghaw = `gh extension install github/gh-aw     # install the extension
gh aw init                               # add authoring skills, instructions and an agent
gh aw compile                            # markdown -> hardened .lock.yml (commit both)
gh aw run daily-status                   # run a workflow
gh aw logs                               # recent runs: duration, tokens, AIC estimates
gh aw audit 1234567890                   # inspect one run in detail`;

const actionsBlocks = `on:
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read                              # least privilege by default

concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }}
  cancel-in-progress: true

jobs:
  plan:
    if: github.event_name == 'pull_request'   # defensive gating: PR-only logic
    runs-on: ubuntu-latest
    outputs:
      risk: \${{ steps.plan.outputs.risk }}    # job output = contract for later jobs
    steps:
      - id: plan
        run: echo "risk=low" >> "$GITHUB_OUTPUT"   # step output

  deploy:
    needs: plan
    if: needs.plan.outputs.risk == 'low'
    runs-on: ubuntu-latest
    environment: production                   # required reviewers, scoped secrets
    env:
      REGION: \${{ vars.DEPLOY_REGION }}       # vars.* = centrally managed configuration
    steps:
      - run: echo "Deploying to $REGION"`;

const prTemplate = `<!-- .github/pull_request_template.md -->
