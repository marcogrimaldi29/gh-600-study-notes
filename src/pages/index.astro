---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/Callout.astro';
import Mermaid from '../components/Mermaid.astro';
import NavCard from '../components/NavCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { PAGES, SITE, SKILL_PAGES } from '../data/site';
import { absolute, asset, href } from '../lib/urls';

// Foundations first, then the final-review pages, after the skill cards.
const otherPages = PAGES.filter((p) => p.slug !== '' && p.group !== 'skills');
const certName = SITE.certification.replace('GitHub Certified: ', '');

const description = `Exam-focused study notes for Exam ${SITE.exam}: ${SITE.examTitle} (${SITE.certification}). Aligned to the skills measured, study guide revision of ${SITE.skillsMeasured}, with Mermaid diagrams, config samples and exam caveats.`;

const schema = [
  {
    '@type': 'Course',
    name: `Exam ${SITE.exam}: ${SITE.examTitle} — Study Notes`,
    description,
    url: absolute(SITE.origin, ''),
    inLanguage: 'en',
    provider: { '@type': 'Person', name: SITE.author.name, url: SITE.author.site },
    teaches: SKILL_PAGES.map((p) => p.label),
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT30H' },
  },
];

// The control plane wraps the agent's execution sandbox, so containment — not
// arrows pointing in from the side — carries that relationship.
const controlPlane = `
flowchart TB
  INTENT["Developer intent<br/>issue · prompt · automation trigger"] --> AGENT

  subgraph CP["GitHub — system of record and control plane"]
    direction TB
    subgraph SANDBOX["Agent sandbox — runner · firewall · scoped token"]
      direction LR
      AGENT["Agent<br/>cloud agent · CLI · custom agent"] --> TOOLS["Tools<br/>built-in · MCP servers · skills"]
    end
    AGENT --> BRANCH["Branch and commits<br/>copilot/… · signed · co-authored"]
    BRANCH --> PR["Draft pull request<br/>plan · evidence · session log"]
    PR --> CHECKS["Checks and scans<br/>CI · CodeQL · secret scanning"]
    CHECKS --> REVIEW["Human review<br/>CODEOWNERS · required approvals"]
  end

  REVIEW --> SHIP["Merge, then deploy<br/>behind an environment gate"]
`;

const journey = `
flowchart TB
  F["Agentic Foundations<br/>mental model and vocabulary"] --> S1["Skill 1 · Architecture and SDLC<br/>15–20%"]
  S1 --> S2["Skill 2 · Tools and MCP<br/>20–25% — the heaviest"]
  S2 --> S3["Skill 3 · Memory and state<br/>10–15%"]
  S2 --> S4["Skill 4 · Evaluation and tuning<br/>15–20%"]
  S3 --> S5["Skill 5 · Multi-agent<br/>15–20%"]
  S4 --> S5
  S5 --> S6["Skill 6 · Guardrails<br/>10–15%"]
  S6 --> CFG["Configuration reference<br/>files and flags"]
  CFG --> TIPS["Exam tips and caveats"]
`;

const modules = [
  {
    title: 'Foundations of Agentic AI in GitHub',
    url: 'https://learn.microsoft.com/en-us/training/modules/foundations-agentic-ai/',
    maps: 'Foundations · Skill 1',
  },
  {
    title: 'Designing Agent Architecture and SDLC Integration',
    url: 'https://learn.microsoft.com/en-us/training/modules/design-agent-architecture-integration/',
    maps: 'Skill 1 · Skill 6',
  },
  {
    title: 'Tooling, MCP, and Agent Execution Environments',
    url: 'https://learn.microsoft.com/en-us/training/modules/agent-tooling-mcp-execution-environments/',
    maps: 'Skill 2',
  },
  {
    title: 'Memory, State, and Evaluation',
    url: 'https://learn.microsoft.com/en-us/training/modules/memory-state-evaluation/',
    maps: 'Skill 3 · Skill 4',
  },
  {
    title: 'Multi-Agent Systems and Orchestration',
    url: 'https://learn.microsoft.com/en-us/training/modules/multi-agent-systems-orchestration/',
    maps: 'Skill 5',
  },
  {
    title: 'Governance, Guardrails, and Operations',
    url: 'https://learn.microsoft.com/en-us/training/modules/governance-guardrails-operations/',
    maps: 'Skill 6',
  },
];
---

<BaseLayout
  title={`${SITE.name} · ${SITE.examTitle}`}
  description={description}
  slug=""
  ogType="website"
  schema={schema}
>
  <div class="layout" data-sidebar="expanded" data-drawer="closed">
    <Sidebar current="" />

    {/* The home page shares the note pages' rail so navigation never changes
        shape between them, but keeps a plain block flow: it has a hero rather
        than a page header, and no section outline. */}
    <main class="page page-home" id="main">
      {/* The GH-300 / GH-900 hero: glowing logo, gradient title, lead, Labels. */}
      <section class="hero">
        <div class="hero-title">
          <img class="hero-logo" src={asset('images/site-mark-no-bg.png')} alt="" width="56" height="56" />
          <h1>{SITE.exam}: {certName}</h1>
        </div>
        <p class="lead">
          A complete, exam-focused companion for <strong>{SITE.examTitle}</strong>, built around the skills measured in
          the official study guide (revision of {SITE.skillsMeasured}). Learn how agents plan, act and get evaluated
          inside GitHub, which control stops what, and where each configuration file lives.
        </p>
        <div class="hero-labels">
          {SITE.heroLabels.map((l) => <span class={`label l-${l.color}`}>{l.text}</span>)}
        </div>
      </section>

      <div class="content">
        <div class="disclaimer">
          <strong>Disclaimer:</strong> these notes are an independent study aid for <strong>learning purposes
          only</strong>, not affiliated with or endorsed by GitHub or Microsoft. GitHub Copilot ships changes almost
          weekly and features are renamed often — always verify details against the official documentation linked
          throughout.
        </div>

        <h2 id="exam-at-a-glance">Exam at a glance</h2>
        <div class="stat-grid">
          <div class="stat"><div class="s-num">{SITE.exam}</div><div class="s-lbl">Exam code</div></div>
          <div class="stat"><div class="s-num">120</div><div class="s-lbl">Minutes</div></div>
          <div class="stat"><div class="s-num">700</div><div class="s-lbl">Passing score</div></div>
          <div class="stat"><div class="s-num">{SKILL_PAGES.length}</div><div class="s-lbl">Skill areas</div></div>
          <div class="stat"><div class="s-num">2 yrs</div><div class="s-lbl">Validity</div></div>
        </div>

        <Callout type="exam" title="Exam format">
          <p>
            The exam is proctored, scheduled through Pearson VUE and offered in English. The certification page warns
            that it <strong>may include interactive components</strong>, so try the
            <a href="https://ghcertdemo.starttest.com/" target="_blank" rel="noopener">exam sandbox</a> to get used to the
            interface. Most questions cover <strong>generally available</strong> features, but commonly used
            <strong>preview</strong> features can appear — and much of the agent tooling (Copilot Memory, custom agents in
            some IDEs, third-party agents, GitHub Agentic Workflows) is still in public preview. If you fail, you can retake
            after 24 hours; later retakes have longer waits.
          </p>
        </Callout>

        <h2 id="what-the-exam-validates">What the exam validates</h2>
        <p>
          {SITE.exam} validates that you can <strong>operate, integrate, supervise and govern AI agents</strong> inside a
          production software development lifecycle, using <strong>GitHub as the system of record and control
          plane</strong>. It is a judgement exam: most questions describe an agent doing something — or about to — and ask
          which control, file, setting or escalation path is right. You are expected to read custom agent profiles, hook
          configurations, MCP JSON, Copilot CLI flags and GitHub Actions YAML and spot what is missing or unsafe.
        </p>
        <Callout type="note" title="How to use these notes">
          <p>
            Start with <a href={href('agentic-foundations')}>Agentic Foundations</a> for the mental model and the
            vocabulary. Work the six skill pages in outline order — Skill 2 is the heaviest, so give it the most time —
            and keep the <a href={href('config-reference')}>Configuration reference</a> open while you practise. Drill
            <a href={href('exam-tips')}>Exam tips &amp; caveats</a> in the final week. These notes are a
            <strong>companion</strong>, not a replacement: pair every page with hands-on time with Copilot cloud agent,
            Copilot CLI and a throwaway repository, and with the official Learn modules listed below.
          </p>
        </Callout>

        <Callout type="rename" title="Names moved while this exam was being written">
          <p>
            <strong>Copilot coding agent</strong> is now <strong>Copilot cloud agent</strong> (renamed in April 2026, when
            it gained research, planning and branch-first work before a pull request). Cloud agent secrets and variables
            moved from the <code>copilot</code> Actions environment to a dedicated <strong>Agents</strong> secrets type.
            In agent profiles, <code>infer</code> is retired in favour of <code>disable-model-invocation</code> and
            <code>user-invocable</code>. Usage is metered in <strong>AI credits</strong>. Learn modules, blog posts and
            practice questions still mix old and new names — the full translation table is on the
            <a href={`${href('agentic-foundations')}#renames`}>Foundations page</a>.
          </p>
        </Callout>

        <h2 id="skills-measured">Skills measured</h2>
        <p>
          The weighting is fairly even, but not flat. <strong>Skill 2 — tools, MCP and execution environments — is the
          single heaviest area</strong>, and Skills 1, 4 and 5 each carry as much as the two smallest areas together.
          Memory and guardrails are the lightest, yet guardrail thinking runs through every other skill.
        </p>
        <div class="card-grid">
          {SKILL_PAGES.map((p) => <NavCard page={p} />)}
        </div>
        <p class="wr-note">Bars are drawn to scale against the largest possible weighting, 25%.</p>

        <h2 id="start-here-and-final-review">Start here and final review</h2>
        <div class="card-grid">
          {otherPages.map((p) => <NavCard page={p} />)}
        </div>

        <h2 id="the-control-plane-in-one-picture">The control plane in one picture</h2>
        <p>
          Almost every {SITE.exam} question sits somewhere on this diagram. An agent runs inside a bounded sandbox, and
          everything it produces flows through the same branch → pull request → checks → review path as a human's work.
          If you can say which box a control lives in, you can usually eliminate half the answers.
        </p>
        <Mermaid
          code={controlPlane}
          caption="GitHub wraps the agent's sandbox — an Actions runner behind a firewall, with a scoped token and a 59-minute session. Work is proposed on a branch, validated by checks and accepted by people and policy: rulesets, CODEOWNERS, required checks, environments and the audit log."
        />

        <h2 id="suggested-study-order">Suggested study order</h2>
        <Mermaid
          code={journey}
          caption="Foundations first, then the skills in outline order. Memory and evaluation can be studied in either order — both feed multi-agent coordination."
        />

        <h2 id="official-learning-path">The official learning path</h2>
        <p>
          Course {SITE.course} is a one-day instructor-led course, and its self-paced content is split across six
          Microsoft Learn modules. They are short and scenario-driven; read each one alongside the skill page it maps to.
        </p>
        <div class="table-wrap">
          <table class="tbl">
            <thead><tr><th>Learn module</th><th>Maps to</th></tr></thead>
            <tbody>
              {
                modules.map((m) => (
                  <tr>
                    <td>
                      <a href={m.url} target="_blank" rel="noopener">
                        {m.title}
                      </a>
                    </td>
                    <td>{m.maps}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <Callout type="tip" title="Two habits that pay off more than extra reading">
          <p>
            <strong>One:</strong> for every control, be able to say whether it is <em>guidance</em> or
            <em>enforcement</em>. An instruction that says "do not edit workflows" is guidance; a tool allowlist, a
            <code>preToolUse</code> hook, a ruleset or a CODEOWNERS-required review is enforcement. The exam rewards the
            enforceable answer almost every time. <strong>Two:</strong> assign one real issue to Copilot cloud agent in a
            test repository, then read the session log, the commits and the pull request it produces. Ten minutes of that
            teaches the branch, token, firewall and approval behaviour better than any page.
          </p>
        </Callout>
      </div>
    </main>
  </div>

  <script>
    // Fill the weighting bars when they scroll into view.
    const bars = document.querySelectorAll<HTMLElement>('.weight-fill[data-pct]');
    if (bars.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            el.style.width = `${el.dataset.pct}%`;
            observer.unobserve(el);
          });
        },
        { threshold: 0.35 },
      );
      bars.forEach((b) => observer.observe(b));
    }
  </script>
</BaseLayout>
